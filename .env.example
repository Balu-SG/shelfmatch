# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
# Leave empty to run with the mock scan fixture (no units spent).
YOUCAM_API_KEY=
# Set to 1 to force mock mode even with a key, or log raw API responses.
YOUCAM_MOCK=
YOUCAM_LOG_RAW=

# Anthropic key for AI catalog tagging (/api/import). The demo store is pre-tagged.
ANTHROPIC_API_KEY=
# SHELFMATCH_TAG_MODEL=claude-haiku-5-5
